msgstr "Cara memori game dibagi dengan GPU."

msgctxt "UI_MENU_MEMORY_AUTO"
msgid "Automatic"
msgstr "Otomatis"

msgctxt "UI_MENU_MEMORY_IMPORT"
msgid "Import"
msgstr "Impor"

msgctxt "UI_MENU_MEMORY_MIRROR"
